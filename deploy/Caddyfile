# HTTPS for the platform and for every hotel domain. Certificates come from Let's Encrypt automatically.
{
	email {$ACME_EMAIL}
	# Hotel domains get a certificate on first visit, but only if Midotel knows the domain.
	on_demand_tls {
		ask http://api:4000/public/domain-check
	}
}

app.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy admin:3000
}

api.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy api:4000
}

book.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy booking:3002
}

sites.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy site:3001
}

# Every other host name pointed at this server: a hotel website (e.g. www.yourhotel.com or demo.{$DOMAIN}).
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy site:3001
}
