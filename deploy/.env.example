# Copy to deploy/.env on the server and fill in. Never commit the real file.
DOMAIN=midotel.example            # your platform domain, without www
ACME_EMAIL=you@example.com        # Let's Encrypt contact for certificate expiry notices

# Generate each secret with:  openssl rand -hex 32
DB_ADMIN_PASSWORD=
DB_APP_PASSWORD=
SECRETS_KEY=
PREVIEW_SECRET=
DEMO_GATEWAY_SECRET=

# Optional: real email (Postmark) and WhatsApp (Meta Cloud API). Leave empty for the demo.
POSTMARK_TOKEN=
MAIL_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
