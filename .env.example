# Local development only. Copy to .env (the defaults below already match scripts/dev-db.ts).
# Superuser connection, used only by migrations.
DATABASE_ADMIN_URL=postgres://postgres:midotel_dev_admin@localhost:5433/midotel
# Application connection: non-superuser role, row-level security applies.
DATABASE_URL=postgres://midotel_app:midotel_dev_app@localhost:5433/midotel
API_PORT=4000
# Admin app talks to the API through a same-origin rewrite.
API_INTERNAL_URL=http://localhost:4000

# Email: without these, emails are saved as HTML files in .data/mail for local preview.
# POSTMARK_TOKEN=
# MAIL_FROM=bookings@your-midotel-domain.com
# Public links used inside emails.
BOOKING_PUBLIC_URL=http://localhost:3002
ADMIN_PUBLIC_URL=http://localhost:3000

# WhatsApp (Meta WhatsApp Cloud API). Without these, messages are saved in .data/whatsapp locally.
# Templates to register in Meta Business Manager: docs/whatsapp-templates.md
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
